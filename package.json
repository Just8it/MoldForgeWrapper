{
  "name": "moldforge-offline",
  "version": "1.0.2",
  "private": true,
  "description": "Offline MoldForge wrapper with network access blocked",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:app": "electron test/app.cjs",
    "dist": "npm run test && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.moldforge.offline",
    "productName": "MoldForge Offline",
    "files": [
      "main.cjs",
      "site/**/*"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "artifactName": "MoldForge-Offline-${version}-${arch}.${ext}",
    "electronVersion": "45.3.2"
  },
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.8"
  }
}
